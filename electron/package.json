{
  "name": "nova-electron",
  "version": "0.1.0",
  "description": "Nova — local-first AI desktop assistant",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron . --ozone-platform=x11",
    "dev": "npm run build && electron . --ozone-platform=x11",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.10.0",
    "lucide-react": "^1.33.0",
    "marked": "^15.0.0",
    "marked-highlight": "^2.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.9.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "electron@44.9.3": true,
    "esbuild@0.25.12": true
  }
}
